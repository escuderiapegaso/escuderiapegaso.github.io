---
/**
 * Portada: últimas noticias → pilotos → calendario.
 * (Los socios aparecen a continuación, en el pie común a todas las páginas.)
 */
import NewsHero from '../components/NewsHero.astro';
import DriverPanels from '../components/DriverPanels.astro';
import RaceCalendar from '../components/RaceCalendar.astro';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getNews } from '../data/news';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const latest = (await getNews(lang)).slice(0, 3);
---

<h1 class="visually-hidden">{t.site.name}</h1>
<NewsHero lang={lang} items={latest} />
<DriverPanels lang={lang} />
<RaceCalendar lang={lang} />
