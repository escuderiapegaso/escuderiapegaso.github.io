---
/** Vista provisional para las secciones que aún no están desarrolladas. */
import { Image } from 'astro:assets';
import emblem from '../assets/brand/pegaso-emblem-black.png';
import PageHeader from '../components/PageHeader.astro';
import type { Lang } from '../i18n/config';
import { getPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  kicker?: string;
}

const { lang, title, kicker } = Astro.props;
const t = useTranslations(lang);
---

<PageHeader title={title} kicker={kicker ?? t.site.name} />

<section class="soon">
  <div class="container soon__inner">
    <Image src={emblem} alt="" width={160} densities={[1, 2]} class="soon__emblem" />
    <h2 class="section-title">{t.comingSoon.title}</h2>
    <p>{t.comingSoon.text}</p>
    <a class="btn btn--primary" href={getPath(lang, 'home')}>{t.comingSoon.back}</a>
  </div>
</section>

<style>
  .soon {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .soon__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .soon__inner :global(.soon__emblem) {
    width: 120px;
    opacity: 0.12;
  }

  .soon p {
    max-width: 44ch;
    color: var(--c-text-muted);
  }

  .soon .btn {
    margin-top: 0.75rem;
  }
</style>
