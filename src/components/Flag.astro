---
/**
 * Bandera SVG en línea (paquete flag-icons). Solo se incrustan las banderas usadas.
 * Uso: <Flag code="CA" label="Canadá" />
 */
interface Props {
  code: string;
  /** Nombre del país para lectores de pantalla. Si se omite, la bandera es decorativa. */
  label?: string;
  class?: string;
}

const { code, label, class: className } = Astro.props;

const flags = import.meta.glob<string>('../../node_modules/flag-icons/flags/4x3/*.svg', {
  query: '?raw',
  import: 'default',
});

const key = `../../node_modules/flag-icons/flags/4x3/${code.toLowerCase()}.svg`;
const loader = flags[key];
if (!loader) throw new Error(`Bandera no encontrada: ${code}`);

const svg = (await loader())
  .replace(/<svg\b/, `<svg class="flag${className ? ` ${className}` : ''}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} focusable="false"`);
---

<Fragment set:html={svg} />

<style is:global>
  svg.flag {
    display: inline-block;
    width: 1.5em;
    height: auto;
    aspect-ratio: 4 / 3;
    vertical-align: -0.15em;
    border-radius: 1px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
</style>
