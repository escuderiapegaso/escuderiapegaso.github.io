---
import { Image } from 'astro:assets';
import emblem from '../assets/brand/pegaso-emblem-white.png';
import { langs, languages, type Lang } from '../i18n/config';
import { getPath, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { teamSponsor, partners, engineSupplier } from '../data/sponsors';
import { season } from '../data/team';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);

const exploreA: RouteKey[] = ['car', 'team', 'news', 'races', 'history'];
const exploreB: RouteKey[] = ['ddp', 'open-series', 'sponsors', 'fanclub', 'shop'];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <section class="partners" aria-labelledby="partners-title">
    <div class="container">
      <h2 id="partners-title" class="kicker">{t.footer.partners}</h2>

      <div class="partners__grid">
        <div class="partners__group partners__group--title">
          <p class="partners__label">{t.footer.teamSponsor}</p>
          <a class="logo-box logo-box--lg" href={getPath(lang, 'sponsors')}>
            <Image src={teamSponsor.logo} alt={teamSponsor.name} width={320} densities={[1, 2]} />
          </a>
        </div>

        <div class="partners__group partners__group--engine">
          <p class="partners__label">{t.footer.powerUnit}</p>
          <div class="logo-box logo-box--lg">
            <Image
              src={engineSupplier.logo}
              alt={engineSupplier.name}
              width={200}
              densities={[1, 2]}
              class:list={[{ invert: engineSupplier.invertOnLight }]}
            />
          </div>
        </div>
      </div>

      <ul class="partners__list" role="list">
        {
          partners.map((p) => (
            <li class:list={['logo-box', { 'logo-box--tall': p.tall }]}>
              <Image src={p.logo} alt={p.name} width={200} densities={[1, 2]} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="footer-main">
    <div class="container footer-main__inner">
      <div class="footer-brand">
        <Image src={emblem} alt="" width={64} densities={[1, 2]} />
        <p class="footer-brand__name display">{t.site.name}</p>
        <p class="footer-brand__season">{t.common.season} {season.number} · {season.car.chassis}</p>
      </div>

      <nav class="footer-nav" aria-label={t.footer.explore}>
        <p class="footer-nav__title">{t.footer.explore}</p>
        <div class="footer-nav__cols">
          {
            [exploreA, exploreB].map((col) => (
              <ul role="list">
                {col.map((key) => (
                  <li>
                    <a href={getPath(lang, key)}>{t.pages[key as keyof typeof t.pages]}</a>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </nav>

      <nav class="footer-lang" aria-label={t.nav.language}>
        <p class="footer-nav__title">{t.nav.language}</p>
        <ul role="list">
          {
            langs.map((l) => (
              <li>
                <a
                  href={getPath(l, routeKey)}
                  hreflang={languages[l].htmlLang}
                  lang={languages[l].htmlLang}
                  aria-current={l === lang ? 'true' : undefined}
                >
                  {languages[l].label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="container footer-legal">
      <p>{t.footer.disclaimer}</p>
      <p>© {year} {t.site.name} · My Racing Career</p>
    </div>
  </div>
</footer>

<style>
  /* ---------- Socios ---------- */
  .partners {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    background: var(--c-surface);
    border-top: 1px solid var(--c-line);
  }

  .partners__grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .partners__label {
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 112px;
    padding: 1.5rem 2rem;
    background: #fff;
    border: 1px solid var(--c-line);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  a.logo-box:hover {
    border-color: var(--c-primary);
    box-shadow: 0 8px 24px rgba(165, 0, 52, 0.08);
  }

  .logo-box :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .logo-box--lg {
    height: 140px;
  }

  .logo-box--lg :global(img) {
    max-height: 64px;
  }

  .partners__group--title .logo-box :global(img) {
    max-width: min(100%, 320px);
  }

  .partners__group--engine .logo-box :global(img) {
    max-height: 72px;
  }

  :global(img.invert) {
    filter: invert(1);
  }

  .partners__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .partners__list .logo-box {
    height: 96px;
    padding: 1.25rem 1.5rem;
  }

  .partners__list .logo-box :global(img) {
    max-height: 48px;
  }

  .partners__list .logo-box--tall {
    padding-block: 0.75rem;
  }

  .partners__list .logo-box--tall :global(img) {
    max-height: 70px;
  }

  @media (min-width: 720px) {
    .partners__grid {
      grid-template-columns: 2fr 1fr;
    }
    .partners__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .partners__list {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  /* ---------- Pie principal ---------- */
  .footer-main {
    background: var(--c-ink);
    color: rgba(255, 255, 255, 0.78);
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .footer-main__inner {
    display: grid;
    gap: 2.5rem;
  }

  .footer-brand :global(img) {
    width: 64px;
  }

  .footer-brand__name {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: #fff;
  }

  .footer-brand__season {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
  }

  .footer-nav__title {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
  }

  .footer-nav__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2rem;
  }

  .footer-main ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-main li a {
    display: inline-block;
    padding: 0.3rem 0;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .footer-main li a:hover,
  .footer-main li a[aria-current] {
    color: #fff;
  }

  .footer-lang a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--c-primary-light);
    text-underline-offset: 5px;
  }

  .footer-legal {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-legal p:first-child {
    max-width: 72ch;
  }

  @media (min-width: 900px) {
    .footer-main__inner {
      grid-template-columns: 1.3fr 1.5fr 0.8fr;
    }
    .footer-legal {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
