---
/** Flecha dentro de un círculo. `dir="left"` la gira hacia la izquierda. */
interface Props {
  dir?: 'left' | 'right';
}
const { dir = 'right' } = Astro.props;
---

<span class="circle-arrow" aria-hidden="true">
  <svg viewBox="0 0 12 12" style={dir === 'left' ? 'transform: rotate(180deg)' : undefined}>
    <path d="M4 1.5 8.5 6 4 10.5" fill="none" stroke="currentColor" stroke-width="1.6" />
  </svg>
</span>
